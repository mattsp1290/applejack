+
+/* DXMT 0.80 finds this table with dlsym(RTLD_DEFAULT, "macdrv_functions") and
+ * reads the client view at a fixed offset of what get_win_data returns, so the
+ * layout of both is its ABI. It dereferences the result with no NULL check, so
+ * a window without data gets an empty struct, which fails as "no Metal view"
+ * rather than as a crash. */
+static struct dxmt_win_data dxmt_no_win_data;
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_client_surface *surface = NULL;
+    struct macdrv_win_data *data;
+
+    if (!(data = get_win_data(hwnd))) return &dxmt_no_win_data;
+
+    /* A client surface and not a bare view, because win32u moves and sizes a
+     * surface's view with the window's client area and disposes of it with the
+     * window. It is created with no win data held: every other path takes
+     * surfaces_lock first and win_data_mutex second. */
+    if (!data->dxmt_surface)
+    {
+        release_win_data(data);
+        surface = macdrv_client_surface_create(hwnd);
+        data = get_win_data(hwnd);
+        if (surface && data && !data->dxmt_surface)
+        {
+            data->dxmt_surface = surface;
+            surface = NULL;
+        }
+        if (surface)
+        {
+            release_win_data(data);
+            client_surface_release(&surface->client);
+            data = get_win_data(hwnd);
+        }
+        if (!data) return &dxmt_no_win_data;
+    }
+
+    data->dxmt.hwnd = hwnd;
+    data->dxmt.cocoa_window = data->cocoa_window;
+    data->dxmt.cocoa_view = data->dxmt.client_cocoa_view = NULL;
+    if (data->dxmt_surface)
+    {
+        /* A racing create, or another surface on this window, may have hidden it. */
+        macdrv_client_surface_present(&data->dxmt_surface->client, 0);
+        data->dxmt.cocoa_view = data->dxmt.client_cocoa_view = data->dxmt_surface->cocoa_view;
+    }
+
+    /* The lock stays held until dxmt_release_win_data, as for get_win_data: it
+     * keeps the view alive while DXMT adds its Metal view to it. */
+    return &data->dxmt;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *dxmt)
+{
+    if (dxmt != &dxmt_no_win_data)
+        release_win_data(CONTAINING_RECORD(dxmt, struct macdrv_win_data, dxmt));
+}
+
+struct dxmt_macdrv_functions
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    macdrv_window (*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    macdrv_metal_device (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(macdrv_metal_device d);
+    macdrv_metal_view (*macdrv_view_create_metal_view)(macdrv_view v, macdrv_metal_device d);
+    macdrv_metal_layer (*macdrv_view_get_metal_layer)(macdrv_metal_view v);
+    void (*macdrv_view_release_metal_view)(macdrv_metal_view v);
+    void (*on_main_thread)(void *block);
+};
+
+/* The two NULL slots have no Wine 11.0 counterpart and DXMT 0.80 never calls them. */
+__attribute__((visibility("default")))
+const struct dxmt_macdrv_functions macdrv_functions =
+{
+    NULL,
+    dxmt_get_win_data,
+    dxmt_release_win_data,
+    macdrv_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    NULL,
+};
