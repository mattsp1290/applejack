+/* A content view keeps one Metal view, so every swap chain on a window shares
+ * it, and DXMT holds its layer unretained. Each user owns a reference, and the
+ * last one takes the view off the window. */
+macdrv_metal_view macdrv_view_acquire_dxmt_metal_view(macdrv_view v, macdrv_metal_device d)
+{
+    id<MTLDevice> device = (id<MTLDevice>)d;
+    WineContentView* view = (WineContentView*)v;
+    __block WineMetalView *metalView;
+
+    OnMainThread(^{
+        metalView = [view newMetalViewWithDevice:device];
+        if (metalView && metalView->_dxmtUsers++)
+            [metalView retain];
+    });
+
+    return (macdrv_metal_view)metalView;
+}
+
+void macdrv_view_release_dxmt_metal_view(macdrv_metal_view v)
+{
+    WineMetalView* view = (WineMetalView*)v;
+
+    OnMainThread(^{
+        if (!--view->_dxmtUsers)
+            [view removeFromSuperview];
+        [view release];
+    });
+}
